#!/bin/bash
# NVIDIA-Nemotron-3-Nano-30B-A3B-AWQ on vLLM 0.22+PR#42032 (jinyouzhi:xpu_w4,
# HEAD 0fd604c72) + 5 local patches / Lunar Lake.
# Updated 2026-06-10: tightened mml→8K for smoke test, refreshed observation
# points based on tonight's Qwen3.5/Gemma 4 findings.
#
# THE ACTUAL EXPERIMENT — three unknowns, ranked by likelihood:
#   1. Does XPUExpertsInt4 (new code in PR #42032) crash the same way the
#      v19 backport did on Nemotron-H's hidden=2688/intermediate=1856 dims?
#      The original crash was inside cutlass_grouped_gemm_interface. PR
#      #42032's code is structurally different (new XPUExpertsInt4 class
#      replaces the v19 _apply_xpu_int4 path), but may share the same
#      shape assumption from vllm_xpu_kernels.
#   2. If MoE is OK, does Mamba2 SSM JIT-compile on XPU? The ops are
#      Triton-based (@triton.jit in ssd_chunk_scan.py, ssd_combined.py),
#      and tonight's Qwen3.5 result shows the related GDN has a working
#      Triton/FLA path on XPU. Mamba2 likely "just works" via Triton XPU
#      JIT — but unverified.
#   3. If both pass, can it actually generate? Perf will be slow (Mamba2
#      via Triton + 128 expert top-6 dispatch), but functional matters.
#
# Outcome interpretation:
# - Loads + serves → #42032's XPUExpertsInt4 handles the dim mismatch;
#   Mamba2 XPU runs via Triton JIT. Big win — measure + memory.
# - Same `ptr_A.size(1)` shape crash → XPUExpertsInt4 needs ~10-line
#   _supports_shape eligibility check; oracle falls through to TRITON
#   (TritonWNA16Experts wired tonight in patch family).
# - Mamba2 Triton JIT failure → file as known issue, not patchable today.
# - Different MoE crash → diagnose & report.
#
# STACK
#   target : /shared/models/nemotron-3-nano-30b-a3b-awq (16.8 GB INT4)
#   venv   : ~/vllm-v22-venv
#   class  : NemotronHForCausalLM (v22 registry.py:180)
#   arch   : 52 layers (23 Mamba2 + 23 MoE + 6 GQA attn), hidden=2688, inter=1856
#   ssm    : mamba_num_heads 64, ssm_state_size 128, chunk_size 128
#   moe    : 128 routed top-6 + 1 shared, moe_intermediate=1856
#   quant  : compressed-tensors INT4 group_size 64 sym
#   port   : 8091
#
# OBSERVATION POINTS TO WATCH IN LOG
#   - oracle dispatch line: int_wna16.py:165 → which WNA16 MoE backend?
#   - mamba2 ops: any "Compiling Triton kernel" / "Loading SPV" / JIT errors?
#   - profile_run: does dummy forward survive? this is where v21+v19backport died
#
# Reasoning + tool calling (unchanged from v21 launcher; bundled parser file)
#   --reasoning-parser-plugin /shared/models/.../nano_v3_reasoning_parser.py
#   --reasoning-parser nano_v3
#   --tool-call-parser qwen3_coder

# ---- gate: host MemAvailable ----
HOST_AVAIL_GIB=$(awk '/MemAvailable:/ {print int($2/1024/1024)}' /proc/meminfo)
echo "Host MemAvailable: ${HOST_AVAIL_GIB} GiB"
if [ "$HOST_AVAIL_GIB" -lt 24 ]; then
    echo "MemAvailable ${HOST_AVAIL_GIB} GiB < 24 GiB — free memory or reboot. Abort."
    echo "(If lfm2-24b-v22 is running on 8090, kill it first.)"
    exit 1
fi

# ---- env: scrub oneAPI off LD_LIBRARY_PATH (nosetvars; CRITICAL on this fork) ----
export LD_LIBRARY_PATH=$(echo "${LD_LIBRARY_PATH:-}" | tr ':' '\n' | grep -v '/opt/intel/oneapi' | paste -sd: -)

source ~/vllm-v22-venv/bin/activate
export VLLM_TARGET_DEVICE=xpu
export VLLM_WORKER_MULTIPROC_METHOD=spawn

# ---- Lunar Lake L0 V1 adapter pin ----
export SYCL_UR_USE_LEVEL_ZERO_V2=0
export UR_LOADER_USE_LEVEL_ZERO_V2=0
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu

# ---- persistent JIT caches (v22-dedicated) ----
export SYCL_CACHE_PERSISTENT=1
export SYCL_CACHE_DIR=${HOME}/.cache/sycl-vllm-xpu-v22
export NEO_CACHE_PERSISTENT=1
export NEO_CACHE_DIR=${HOME}/.cache/neo-vllm-xpu-v22
mkdir -p "$SYCL_CACHE_DIR" "$NEO_CACHE_DIR"

exec vllm serve /shared/models/nemotron-3-nano-30b-a3b-awq \
    --served-model-name nemotron-3-nano \
    --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.70 \
    --enforce-eager \
    --trust-remote-code \
    --port 8091 \
    --max-model-len 65536 \
    --max-num-seqs 2 \
    --kv-cache-memory-bytes 1500000000 \
    --enable-auto-tool-choice \
    --tool-call-parser qwen3_coder \
    --reasoning-parser-plugin /shared/models/nemotron-3-nano-30b-a3b-awq/nano_v3_reasoning_parser.py \
    --reasoning-parser nano_v3 \
    "$@"
